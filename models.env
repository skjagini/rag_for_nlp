# Model and endpoint settings for every lab. Change a line here, once, and every notebook picks it up.
# This file is committed and holds no secrets: keys go in .env (local), Codespaces secrets or Colab Secrets.
# A line in .env, or an environment variable, overrides the value here.

# Endpoint for chat calls. Empty means OpenAI's default (https://api.openai.com/v1).
# Set it to the /v1 address of another OpenAI-compatible server to run the labs there.
OPENAI_BASE_URL=

# Endpoint for embedding calls. Empty means the same as OPENAI_BASE_URL.
# Set it only when your chat provider has no embeddings; put that provider's key in .env as EMBED_API_KEY.
EMBED_BASE_URL=

# Chat model: answers, summaries and follow-up rewrites (Labs 01 on).
# gpt-4o-mini shuts down on 14 Jan 2027 (OpenAI deprecations page, checked 18 Oct 2026). Its listed replacement,
# gpt-6-luna, is a reasoning model: when you switch, set JUDGE_MODEL and RERANK_MODEL to it as well, and
# REASONING_EFFORT=none below. REASONING_EFFORT goes to every chat model, and gpt-4o-mini rejects it.
CHAT_MODEL=gpt-4o-mini

# Embedding model: every index and every query (Labs 01 on). Changing it means re-embedding every chunk;
# the labs' caches are named after it, so old and new vectors never mix.
EMBED_MODEL=text-embedding-3-small

# Judge model (Lab 07 on). A model from another family is better when one is allowed.
JUDGE_MODEL=gpt-4o-mini

# Reranking model (Lab 08).
RERANK_MODEL=gpt-4o-mini

# Reasoning effort. Leave empty for models without it (gpt-4o-mini rejects the parameter).
# For a reasoning model, set none, low, medium or high. The labs send temperature only when this is empty or none.
REASONING_EFFORT=

# How the labs ask for JSON: json_schema (a strict schema; OpenAI and most compatible servers) or json_object
# (valid JSON, schema unchecked) for servers without strict schemas. Every reply is validated either way.
JSON_MODE=json_schema

# Tokenizer for local token estimates before a call (Labs 02 and 10). The billed count is the reply's usage.
TOKEN_ENCODING=o200k_base

# Shortened embeddings, OpenAI only (Lab 01, Going further). Empty means the model's full length.
EMBED_DIMENSIONS=

# Managed file search, OpenAI only (Optional B). Empty skips the cells that upload the passages to OpenAI's hosted
# vector store and search it; set it to on to run them. OpenAI bills the storage and each file search call.
MANAGED_SEARCH=

# Prices in US dollars per 1M tokens, for the cost tables in Labs 08 and 10. Update them with the models.
# Checked 18 Oct 2026 at developers.openai.com/api/docs/pricing.
CHAT_PRICE_INPUT=0.15
CHAT_PRICE_CACHED_INPUT=0.075
CHAT_PRICE_OUTPUT=0.60
EMBED_PRICE_INPUT=0.02
